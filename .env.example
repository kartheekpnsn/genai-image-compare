# Azure authentication (Microsoft Entra ID via DefaultAzureCredential)
# Use one of: az login, VS Code Azure sign-in, managed identity, or service principal env vars.
AZURE_AUTH_SCOPE=https://cognitiveservices.azure.com/.default

MAI_ENDPOINT=https://<resource-name>.services.ai.azure.com/mai/v1/images/generations?api-version=preview
MAI_MODEL=MAI-Image-2.5

AZURE_IMAGE_WIDTH=1024
AZURE_IMAGE_HEIGHT=1024
AZURE_IMAGE_N=1

# Azure GPT Image (OpenAI Images API)
GPT_IMAGE_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/openai/deployments/{model_name}/images/generations?api-version=2024-02-01
GPT_IMAGE_MODEL=gpt-image-2